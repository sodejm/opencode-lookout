{
  "name": "opencode-lookout",
  "version": "0.1.0",
  "description": "A native-style resource sidebar for OpenCode, with reversible local controls.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sodejm/opencode-lookout.git"
  },
  "bugs": {
    "url": "https://github.com/sodejm/opencode-lookout/issues"
  },
  "homepage": "https://github.com/sodejm/opencode-lookout#readme",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/server.ts",
    "./tui": "./src/tui.tsx",
    "./rpc": "./src/rpc.ts"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check 'src/**/*.{mjs,ts,tsx}' 'test/**/*.mjs' 'bin/*.mjs' 'scripts/*.mjs' '*.json' '.github/**/*.yml'",
    "test:integration": "node test/integration.mjs",
    "test:tui": "CC_TUI=1 node test/integration.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "check": "npm run format:check && npm run docs:check && npm run typecheck && npm test"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@opencode/client": "2.2.5",
    "@opencode/plugin": "2.2.5",
    "@opencode/theme": "2.2.5",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "@types/node": "26.6.6",
    "prettier": "3.9.10",
    "solid-js": "1.9.16",
    "typescript": "5.9.3"
  }
}
