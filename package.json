{
  "name": "opencode-lookout",
  "version": "0.1.0",
  "description": "A native-style resource sidebar for OpenCode, with reversible local controls.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sodejm/opencode-lookout.git"
  },
  "bugs": {
    "url": "https://github.com/sodejm/opencode-lookout/issues"
  },
  "homepage": "https://github.com/sodejm/opencode-lookout#readme",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/server.ts",
    "./tui": "./src/tui.tsx",
    "./rpc": "./src/rpc.ts"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test:compatibility": "node scripts/compatibility.mjs",
    "security": "node scripts/security.mjs",
    "release:check": "node scripts/release-check.mjs",
    "format:check": "prettier --check 'src/**/*.{mjs,ts,tsx}' 'test/**/*.mjs' 'bin/*.mjs' 'scripts/*.mjs' '*.json' '.github/**/*.yml' '.vscode/*.json' 'eslint.config.mjs' 'opencode-lookout.code-workspace'",
    "test:integration": "node test/integration.mjs",
    "test:tui": "LOOKOUT_TUI=1 node test/integration.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "check": "npm run format:check && npm run docs:check && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1"
  },
  "overrides": {
    "glob@>=9 <=14.0.1": "14.0.3",
    "minimatch@>=7 <11.0.1": "11.0.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@opencode/client": "2.2.5",
    "@opencode/plugin": "2.2.5",
    "@opencode/theme": "2.2.5",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "@types/node": "24.10.0",
    "eslint": "10.14.0",
    "eslint-plugin-jsdoc": "65.4.3",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "solid-js": "1.9.16",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
